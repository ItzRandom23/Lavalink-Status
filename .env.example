DISCORD_TOKEN=''
DISCORD_CHANNEL_ID=

LAVALINK_IDENTIFIER=Local
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_TLS=false

POLL_INTERVAL_SECONDS=60
LAVALINK_TIMEOUT_MS=5000
STATUS_DATA_DIR=.data
# STATUS_MESSAGE_ID=

LAVALINK_PASSWORD=''

# Multiple Lavalink nodes
# Comment out or remove LAVALINK_IDENTIFIER, LAVALINK_HOST, LAVALINK_PORT,
# LAVALINK_TLS, and LAVALINK_PASSWORD above. Uncomment the example below
# and replace the node settings. Keep the JSON on one line and use a unique
# ID and endpoint for each node. You can configure up to 16 nodes.
# LAVALINK_NODES='[{"id":"Primary","host":"audio.example.net","port":443,"tls":true,"password":"replace-primary"},{"id":"Backup","host":"127.0.0.1","port":2333,"tls":false,"password":"replace-backup"}]'
